# uiautomator UI hierarchy dumps — point-in-time debug artifacts that also
# capture whatever inspection data was on screen when they were taken
*-window.xml
window_dump.xml

# Subagent-driven-development scratch (ledgers, briefs, review packages)
.superpowers/

# graphify knowledge graph - regenerated locally by the post-commit/post-checkout
# hooks (graphify-out/.graphify_root, cache/, graph.json, graph.html); keeping it
# out of git avoids multi-MB diffs on every commit
graphify-out/

# Claude Code personal settings (the shared file is .claude/settings.json;
# this one holds machine-specific paths and stays local)
.claude/settings.local.json
