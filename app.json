{
  "expo": {
    "name": "InspectPlus EMB4A",
    "slug": "inspectplus-emb4a",
    "scheme": "inspectplus4a",
    "version": "1.0.0",
    "icon": "./assets/icons/app_icon_night_mode.png",
    "router": {
      "root": "src/app"
    },
    "ios": {
      "bundleIdentifier": "com.inspectplus.emb4a"
    },
    "android": {
      "package": "com.inspectplus.emb4a",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/app_icon_night_mode.png",
        "backgroundColor": "#0d2137"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "InspectPlus EMB4A uses the camera to attach inspection photos.",
          "photosPermission": "InspectPlus EMB4A needs access to your photo library to attach existing photos.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "InspectPlus EMB4A uses your location to geotag photos taken during an inspection."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "InspectPlus EMB4A needs access to your photos to save downloaded attachments.",
          "savePhotosPermission": "InspectPlus EMB4A saves downloaded attachments to your photo library.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-sharing",
      "expo-asset",
      "@maplibre/maplibre-react-native"
    ],
    "owner": "jonathanremonte"
  }
}
