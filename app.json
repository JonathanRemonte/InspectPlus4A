{
  "expo": {
    "name": "InspectPlus",
    "slug": "inspectplus",
    "scheme": "inspectplus",
    "version": "1.0.4",
    "icon": "./assets/icons/app_icon_night_mode.png",
    "router": {
      "root": "src/app"
    },
    "ios": {
      "bundleIdentifier": "com.inspectplus"
    },
    "android": {
      "package": "com.inspectplus",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/app_icon_night_mode.png",
        "backgroundColor": "#0d2137"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "InspectPlus uses the camera to attach inspection photos.",
          "photosPermission": "InspectPlus needs access to your photo library to attach existing photos.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "InspectPlus uses your location to geotag photos taken during an inspection."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "InspectPlus needs access to your photos to save downloaded attachments.",
          "savePhotosPermission": "InspectPlus saves downloaded attachments to your photo library.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-sharing",
      "expo-asset",
      "@maplibre/maplibre-react-native"
    ],
    "extra": {
      "eas": {
        "projectId": "96f2b410-a311-439d-be28-88c0d23a5201"
      }
    },
    "owner": "jonathanremonte"
  }
}
